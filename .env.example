# =============================================================================
# AI-Powered Invoice Collection Agent — Phase 1 (Foundation)
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env to git.

# --- Application --------------------------------------------------------------
APP_NAME=invoice-collection-agent
APP_ENV=development
APP_DEBUG=true
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js) -------------------------------------------------------
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Backend (FastAPI) --------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-strong-random-secret  # used for session signing

# --- Database (Supabase PostgreSQL) ------------------------------------------
# Provision a Supabase project, then paste the connection string here.
# Format: postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key

# --- PayPal (Sandbox or Mock) -----------------------------------------------------------
# PAYPAL_MODE=mock   -> demo data, no PayPal credentials needed (default)
# PAYPAL_MODE=sandbox -> real PayPal OAuth + REST API (requires sandbox app credentials)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=your-sandbox-client-id      # only needed when PAYPAL_MODE=sandbox
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret  # only needed when PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id    # only needed when PAYPAL_MODE=sandbox

# --- OpenAI (Phase 4: AI Intelligence) -----------------------------------------
# AI_MODE=mock   -> deterministic rules, no API key needed (default)
# AI_MODE=openai -> real OpenAI integration (requires OPENAI_API_KEY)
AI_MODE=mock
OPENAI_API_KEY=your-openai-api-key          # only needed when AI_MODE=openai
OPENAI_MODEL=gpt-4o-mini                    # only needed when AI_MODE=openai

# --- Phase 5: Automated Reminder Scheduling -------------------------------------
# Scheduler interval in seconds (default 300 = 5 minutes)
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_JOB_TYPE=reminder_due_check

# --- Email Provider (Phase 5) ---------------------------------------------------
# EMAIL_MODE=mock   -> simulated email, no real emails sent (default)
# EMAIL_MODE=smtp   -> real SMTP delivery (requires SMTP credentials)
EMAIL_MODE=mock

# SMTP settings (only needed when EMAIL_MODE=smtp)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-from-email@example.com
SMTP_USE_TLS=true
