# =============================================================================
# AI-Powered Invoice Collection Agent — Phase 1 (Foundation)
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env to git.

# --- Application --------------------------------------------------------------
APP_NAME=invoice-collection-agent
APP_ENV=development
APP_DEBUG=true
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js) -------------------------------------------------------
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Backend (FastAPI) --------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-strong-random-secret  # used for session signing

# --- Database (Supabase PostgreSQL) ------------------------------------------
# Provision a Supabase project, then paste the connection string here.
# Format: postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key

# --- PayPal (NOT used in Phase 1 — added here for completeness) --------------
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=

# --- OpenAI (NOT used in Phase 1) --------------------------------------------
# OPENAI_API_KEY=
